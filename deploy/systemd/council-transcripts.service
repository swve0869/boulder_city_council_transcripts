# Serves full transcripts to the GitHub Pages site and counts page views (see serve_transcripts.py).
# Listens on localhost only; expose it with `tailscale funnel --bg @PORT@`.
[Unit]
Description=City council transcript server
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/python serve_transcripts.py --bind 127.0.0.1 --port @PORT@ --origin @ORIGIN@ --visits %S/council-transcripts/visits.json
Restart=on-failure
RestartSec=10
# Read-only everywhere except its own state folder (/var/lib/council-transcripts) for page-view counts.
StateDirectory=council-transcripts
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
